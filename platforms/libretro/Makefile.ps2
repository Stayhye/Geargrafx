# ====================================================================
# PS2 Makefile for Geargrafx Libretro Core
# Target: PlayStation 2 (Emotion Engine MIPS)
# Toolchain: PS2SDK (mips64r5900el-ps2-elf-gcc)
# ====================================================================

TARGET_NAME := geargrafx_libretro_ps2

ifeq ($(PS2SDK),)
  $(error PS2SDK environment variable is not set.)
endif

include $(PS2SDK)/samples/Makefile.pref

CC  := mips64r5900el-ps2-elf-gcc
CXX := mips64r5900el-ps2-elf-g++
AR  := mips64r5900el-ps2-elf-ar

TARGET := $(TARGET_NAME).a

CORE_DIR        := ../../src
LIBRETRO_DIR    := .
THIRD_PARTY_DIR := ../../third_party

# Multi-path include search to cover all possible miniz locations
INCDIRS := \
	-I$(LIBRETRO_DIR) \
	-I$(CORE_DIR) \
	-I$(CORE_DIR)/miniz \
	-I$(CORE_DIR)/common \
	-I$(THIRD_PARTY_DIR) \
	-I$(THIRD_PARTY_DIR)/miniz \
	-I$(THIRD_PARTY_DIR)/miniz/src \
	-I$(PS2SDK)/ee/include \
	-I$(PS2SDK)/common/include

DEFINES := -D__LIBRETRO__ -DABGR1555 -DGEARGRAFX_DISABLE_DEBUGGER -DNDEBUG
EE_CFLAGS   += -O2 -G0 -Wall $(DEFINES) $(INCDIRS)
EE_CXXFLAGS += -O2 -G0 -Wall -fno-rtti -fno-exceptions $(DEFINES) $(INCDIRS)

# Recursively discover C and C++ sources across core and third_party
SOURCES_C   := $(wildcard $(LIBRETRO_DIR)/*.c) \
               $(wildcard $(CORE_DIR)/*.c) \
               $(wildcard $(CORE_DIR)/**/*.c) \
               $(wildcard $(THIRD_PARTY_DIR)/*.c) \
               $(wildcard $(THIRD_PARTY_DIR)/**/*.c)

SOURCES_CXX := $(wildcard $(LIBRETRO_DIR)/*.cpp) \
               $(wildcard $(CORE_DIR)/*.cpp) \
               $(wildcard $(CORE_DIR)/**/*.cpp)

OBJS := $(SOURCES_C:.c=.o) $(SOURCES_CXX:.cpp=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(AR) rcs $@ $(OBJS)

%.o: %.c
	$(CC) $(EE_CFLAGS) -c $< -o $@

%.o: %.cpp
	$(CXX) $(EE_CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)

.PHONY: all clean
